# Ignore everything in the root directory
/*

# Re-include .gitignore
!/.gitignore

# '!' line marks a folder as active
!/src/
!/README.md
!/CMakeLists.txt
!/tests/
!/CMakePresets.json
!/.clang-format
!/third_party/
# Ignore these files and directories
.DS_Store

build/

*.a
*.o
*.obj
*.bin
*.onnx

# Test fixtures (generated by tests/fixtures/make_mlp.py)
!tests/fixtures/mlp.onnx
!tests/fixtures/mlp_input.bin